{% assign card_image = entry.card_img | default: entry.img %}
{% capture card_inner %}
<div class="card almanac-card h-100{% unless entry.no_link %} hoverable{% endunless %}">
  <div class="almanac-card-row">
    {% if card_image %}
      <div class="almanac-card-thumb">
        {% include figure.liquid loading="eager" path=card_image sizes="(max-width: 576px) 90vw, 150px" alt=entry.title class="card-img" %}
      </div>
    {% endif %}
    <div class="almanac-card-text">
      <div class="card-body">
        <h3 class="card-title">{{ entry.title }}</h3>
        {% if entry.subtitle %}
          <p class="card-text project-citation mb-2"><em>{{ entry.subtitle }}</em></p>
        {% endif %}
        <p class="card-text">{{ entry.description }}</p>
      </div>
    </div>
  </div>
</div>
{% endcapture %}
<div class="col almanac-col mb-4">
  {% if entry.no_link %}
    {{ card_inner }}
  {% else %}
    <a href="{% if entry.redirect %}{{ entry.redirect }}{% else %}{{ entry.url | relative_url }}{% endif %}">{{ card_inner }}</a>
  {% endif %}
</div>
