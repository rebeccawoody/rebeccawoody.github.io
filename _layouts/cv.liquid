---
layout: default
---
{% comment %}
  Local override of the al_folio_cv layout.

  The CV is a rendercv-generated PDF (assets/pdf/woody_cv.pdf, built from
  assets/rendercv/Rebecca_Woody_CV.yaml — see assets/rendercv/build_pdf.sh).
  This layout embeds that PDF in an in-browser viewer. The page sets `cv_pdf`
  in its frontmatter.
{% endcomment %}
{% capture pdf_url %}{% if page.cv_pdf contains '://' %}{{ page.cv_pdf }}{% else %}{{ page.cv_pdf | relative_url }}{% endif %}{% endcapture %}
{% assign cv_name = site.first_name | append: ' ' | append: site.last_name | strip %}

<div class="cv-pdf-embed">
  <div class="cv-pdf-bar">
    <a href="{{ pdf_url }}" target="_blank" rel="noopener noreferrer"><i class="fa-solid fa-up-right-from-square"></i> Open in new tab</a>
    <a href="{{ pdf_url }}" download><i class="fa-solid fa-download"></i> Download PDF</a>
  </div>
  <iframe class="cv-pdf-frame" src="{{ pdf_url }}#view=FitH" title="{{ cv_name }} — Curriculum Vitae" loading="lazy"></iframe>
  <p class="cv-pdf-fallback">Can’t see the CV above? <a href="{{ pdf_url }}">Open the PDF directly.</a></p>
</div>
